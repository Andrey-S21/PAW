@model PAW.Web.Models.PagedList<PAW.Models.DTO.PawTaskDTO>
@{
    ViewData["Title"] = "Tasks (Minimal API)";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks <small class="text-muted fs-6">via PAW.MinimalAPI</small></h2>

        <a asp-action="Create" data-modal class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Task
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Created At</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        <strong>@item.Name</strong>
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                    <td>
                                        @item.Status
                                    </td>

                                    <td>
                                        @(item.DueDate?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @(item.LastModified?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @item.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               data-modal
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               data-modal
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               data-modal
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No tasks found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <small class="text-muted">Page @Model.Page of @Model.TotalPages &middot; @Model.TotalItems records</small>
            <partial name="_Pagination" model="Model" />
        </div>
    </div>

</div>
