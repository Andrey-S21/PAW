@model PAW.Models.DTO.UserRoleDTO
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id.ToString() : null)" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit" : "Add") User Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="RoldId" class="form-label">Role ID</label>
            <input asp-for="RoldId" class="form-control" type="number" step="any" />
            <span asp-validation-for="RoldId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User ID</label>
            <input asp-for="UserId" class="form-control" type="number" step="any" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
