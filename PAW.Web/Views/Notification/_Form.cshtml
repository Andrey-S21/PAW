@model PAW.Models.DTO.NotificationDTO
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id.ToString() : null)" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit" : "Add") Notification</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User ID</label>
            <input asp-for="UserId" class="form-control" type="number" step="1" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Message" class="form-label">Message <span class="text-danger">*</span></label>
            <textarea asp-for="Message" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsRead" class="form-check-input" />
            <label asp-for="IsRead" class="form-check-label">Read</label>
        </div>
        <input type="hidden" asp-for="CreatedAt" />
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
