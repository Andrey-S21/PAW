@model PAW.Web.Models.IPagedInfo
@{
    var page = Model.Page;
    var last = Model.TotalPages;
}

@* Formato: <<  <  ...  anterior  "actual"  siguiente  ...  >  >> *@
<nav aria-label="Pagination">
    <ul class="pagination pagination-sm mb-0">

        <li class="page-item @(page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="1" title="First" aria-label="First">&laquo;</a>
        </li>
        <li class="page-item @(page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Math.Max(page - 1, 1))" title="Previous" aria-label="Previous">&lsaquo;</a>
        </li>

        @if (page - 1 > 1)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }
        @if (page > 1)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(page - 1)">@(page - 1)</a></li>
        }

        <li class="page-item active" aria-current="page"><span class="page-link">@(page)</span></li>

        @if (page < last)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(page + 1)">@(page + 1)</a></li>
        }
        @if (page + 1 < last)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        <li class="page-item @(page >= last ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Math.Min(page + 1, last))" title="Next" aria-label="Next">&rsaquo;</a>
        </li>
        <li class="page-item @(page >= last ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@last" title="Last" aria-label="Last">&raquo;</a>
        </li>

    </ul>
</nav>
