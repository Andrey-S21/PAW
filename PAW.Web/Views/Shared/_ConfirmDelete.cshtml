@model PAW.Web.Models.ConfirmDeleteViewModel

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">Delete @Model.EntityName</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        <p class="mb-1">Are you sure you want to delete <strong>@Model.Label</strong>?</p>
        <p class="text-muted mb-0">This action cannot be undone.</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
