
<aside id="exchange-rate" class="exchange-rate" data-state="loading" aria-live="polite">
    <button type="button" id="exchange-rate-toggle" class="exchange-rate__header" aria-expanded="true" aria-controls="exchange-rate-body">
        <span class="exchange-rate__title">Exchange rate</span>
        <span class="exchange-rate__chevron" aria-hidden="true"></span>
    </button>

    <div id="exchange-rate-body" class="exchange-rate__body">
        <dl class="exchange-rate__list">
            <div class="exchange-rate__row"><dt>USD buy</dt><dd data-rate="usd-buy">&ndash;</dd></div>
            <div class="exchange-rate__row"><dt>USD sell</dt><dd data-rate="usd-sell">&ndash;</dd></div>
            <div class="exchange-rate__row"><dt>EUR</dt><dd data-rate="eur-crc">&ndash;</dd></div>
            <div class="exchange-rate__row"><dt>EUR in USD</dt><dd data-rate="eur-usd">&ndash;</dd></div>
        </dl>
        <div class="exchange-rate__footer" data-rate="updated">Loading&hellip;</div>
    </div>
</aside>


