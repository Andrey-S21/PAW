@model PAW.Models.DTO.CategoryDTO

<dl class="row mb-0">
    <dt class="col-sm-4">Category ID</dt>
    <dd class="col-sm-8">@Model.CategoryId</dd>
    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8">@Model.CategoryName</dd>
    <dt class="col-sm-4">Description</dt>
    <dd class="col-sm-8">@Model.Description</dd>
    <dt class="col-sm-4">Last Modified</dt>
    <dd class="col-sm-8">@(Model.LastModified?.ToString("yyyy-MM-dd HH:mm"))</dd>
    <dt class="col-sm-4">Modified By</dt>
    <dd class="col-sm-8">@Model.ModifiedBy</dd>
</dl>
