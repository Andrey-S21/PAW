@model PAW.Models.DTO.UserDTO
@{
    var isEdit = Model.UserId > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.UserId.ToString() : null)" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit" : "Add") User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="UserId" />
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username <span class="text-danger">*</span></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="CreatedAt" />
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
        <div class="mb-3">
            <label asp-for="ModifiedBy" class="form-label">Modified By</label>
            <input asp-for="ModifiedBy" class="form-control" />
            <span asp-validation-for="ModifiedBy" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="RoleId" class="form-label">Role ID</label>
            <input asp-for="RoleId" class="form-control" type="number" step="1" />
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LastModifiedBy" class="form-label">Last Modified By</label>
            <input asp-for="LastModifiedBy" class="form-control" />
            <span asp-validation-for="LastModifiedBy" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
