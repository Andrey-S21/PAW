@model PAW.Models.DTO.ProductDTO

<dl class="row mb-0">
    <dt class="col-sm-4">Product ID</dt>
    <dd class="col-sm-8">@Model.ProductId</dd>
    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8"><strong>@Model.Name</strong></dd>
    <dt class="col-sm-4">Description</dt>
    <dd class="col-sm-8">@Model.Description</dd>
    <dt class="col-sm-4">Rating</dt>
    <dd class="col-sm-8">
        @for (int i = 1; i <= 5; i++)
        {
            if (i <= Model.Rating)
            {
                <span class="text-warning">★</span>
            }
            else
            {
                <span class="text-muted">☆</span>
            }
        }
    </dd>
    <dt class="col-sm-4">Created By</dt>
    <dd class="col-sm-8">@Model.CreatedBy</dd>
    <dt class="col-sm-4">Modified By</dt>
    <dd class="col-sm-8">@Model.ModifiedBy</dd>
    <dt class="col-sm-4">Modified Date</dt>
    <dd class="col-sm-8">@Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>
